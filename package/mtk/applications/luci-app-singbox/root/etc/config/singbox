config singbox 'global'
	option enabled '0'
	option log_level 'info'
	option log_output '/tmp/singbox.log'
	option mixed_port '2080'
	option socks_port '1080'
	option http_port '1081'
	option tun_enabled '0'
	option tun_address '172.19.0.1/30'
	option tun_auto_route '1'
	option tun_stack 'system'
	option clash_api_enabled '0'
	option clash_api_port '9090'
	option clash_api_secret ''
	option external_controller '0.0.0.0:9090'

config subscribe 'sub_node'
	option url ''
	option name ''
	option enabled '1'
	option auto_update '0'
	option update_interval '24'
	option last_update ''
	option ua 'sing-box'

config node 'node'
	option type ''
	option server ''
	option server_port ''
	option name ''
	option tag ''
	option subscribe ''
	option enabled '1'
	# Shadowsocks
	option method ''
	option password ''
	# VMess
	option alter_id ''
	option security ''
	option transport ''
	option path ''
	option host ''
	option tls ''
	option sni ''
	# VLESS
	option flow ''
	# Trojan
	option fingerprint ''
	# Hysteria2
	option obfs_type ''
	option obfs_password ''
	option up_mbps ''
	option down_mbps ''
