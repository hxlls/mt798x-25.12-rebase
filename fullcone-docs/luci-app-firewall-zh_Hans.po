
# --- fullcone NAT (added by the fullcone branch) ---

msgid "Fullcone NAT (IPv4)"
msgstr "全锥形 NAT(IPv4)"

msgid "Fullcone NAT (IPv6)"
msgstr "全锥形 NAT(IPv6)"

msgid "Fullcone NAT"
msgstr "全锥形 NAT"

msgid "Fullcone protocols"
msgstr "全锥形 NAT 协议"

msgid "All protocols"
msgstr "所有协议"

msgid "Global gate for fullcone NAT. When enabled, individual zones with masquerading can opt in and optionally restrict fullcone to specific protocols."
msgstr "全锥形 NAT 的全局总开关。启用后，各开启了 IPv4 伪装的区域可以分别开启，并可限定只对特定协议生效。"

msgid "Global gate for fullcone NAT on IPv6. Most IPv6 setups do not need fullcone."
msgstr "IPv6 的全锥形 NAT 全局总开关。大多数 IPv6 环境不需要全锥形 NAT。"

msgid "Enable fullcone NAT (endpoint-independent mapping and filtering) for this zone. Requires the global \"Fullcone NAT (IPv4)\" gate in the general firewall settings. Use \"Fullcone protocols\" in the Advanced Settings tab to limit it to specific protocols."
msgstr "为本站区启用全锥形 NAT(端点无关映射与过滤)。需要先在防火墙「常规设置」中打开全局的「全锥形 NAT(IPv4)」总开关。可在「高级设置」页签的「全锥形 NAT 协议」中限定只对特定协议生效。"

msgid "Restrict fullcone NAT to the selected L4 protocols; every other protocol keeps plain masquerading. Leave empty to apply fullcone to all protocols."
msgstr "限定全锥形 NAT 只对选中的 L4 协议生效，其余协议仍走普通伪装。留空表示对所有协议生效。"
