From: openwrt-sonic-fullcone integration <noreply@localhost>
Date: Wed, 16 Sep 2026 00:00:00 +0000
Subject: [PATCH] luci-app-firewall: per-zone fullcone options

Adds fullcone NAT configuration to the firewall zone UI:

  - General Settings: "Fullcone NAT (IPv4)" / "(IPv6)" global gates
  - Zone General tab:  "Fullcone NAT" per-zone opt-in (shown with masquerading)
  - Zone Advanced tab: "Fullcone protocols" L4 protocol restriction

The options are always rendered; fw4 validates at runtime whether the
fullcone nftables expression is available and disables the feature
globally when it is not, so no system feature probe is needed here.

---
--- a/htdocs/luci-static/resources/view/firewall/zones.js
+++ b/htdocs/luci-static/resources/view/firewall/zones.js
@@ -55,10 +55,17 @@
 		};
 
 		o = s.option(form.Flag, 'drop_invalid', _('Drop invalid packets'));
-		if (L.hasSystemFeature('fullcone')) {
-			o = s.option(form.Flag, 'fullcone', _('Enable FullCone NAT'));
-			if (fw4)
-				o = s.option(form.Flag, 'fullcone6', _('Enable FullCone NAT6'));
+
+		o = s.option(form.Flag, 'fullcone', _('Fullcone NAT (IPv4)'),
+			_('Global gate for fullcone NAT. When enabled, individual zones with masquerading can opt in and optionally restrict fullcone to specific protocols.'));
+		o.default = '0';
+		o.rmempty = true;
+
+		if (fw4) {
+			o = s.option(form.Flag, 'fullcone6', _('Fullcone NAT (IPv6)'),
+				_('Global gate for fullcone NAT on IPv6. Most IPv6 setups do not need fullcone.'));
+			o.default = '0';
+			o.rmempty = true;
 		}
 
 		let p = [
@@ -181,6 +188,12 @@
 			return null;
 		};
 
+		o = s.taboption('general', form.Flag, 'fullcone', _('Fullcone NAT'),
+			_('Enable fullcone NAT (endpoint-independent mapping and filtering) for this zone. Requires the global "Fullcone NAT (IPv4)" gate in the general firewall settings. Use "Fullcone protocols" in the Advanced Settings tab to limit it to specific protocols.'));
+		o.depends('masq', '1');
+		o.default = o.enabled;
+		o.modalonly = true;
+
 		o = s.taboption('general', form.Flag, 'mtu_fix', _('MSS clamping'));
 		o.modalonly = true;
 
@@ -255,6 +268,17 @@
 			};
 		}
 
+		o = s.taboption('advanced', form.MultiValue, 'fullcone_proto', _('Fullcone protocols'),
+			_('Restrict fullcone NAT to the selected L4 protocols; every other protocol keeps plain masquerading. Leave empty to apply fullcone to all protocols.'));
+		o.value('udp', _('UDP'));
+		o.value('tcp', _('TCP'));
+		o.value('udplite', _('UDP-Lite'));
+		o.value('sctp', _('SCTP'));
+		o.value('dccp', _('DCCP'));
+		o.depends('fullcone', '1');
+		o.modalonly = true;
+		o.placeholder = _('All protocols');
+
 		o = s.taboption('advanced', form.ListValue, 'family', _('Restrict to address family'));
 		o.value('', _('IPv4 and IPv6'));
 		o.value('ipv4', _('IPv4 only'));
